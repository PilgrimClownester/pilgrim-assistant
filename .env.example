DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
TZ=Asia/Shanghai

# 公网部署认证（本地桌面端留空即关闭）。密码使用 backend.auth.hash_password 生成，勿写明文。
FIREFLY_AUTH_USERNAME=firefly
FIREFLY_AUTH_PASSWORD_HASH=
FIREFLY_AUTH_SESSION_SECRET=
FIREFLY_AUTH_SESSION_SECONDS=2592000

# Docker Compose（服务器可按实际用户 UID/GID 修改）
FIREFLY_UID=1000
FIREFLY_GID=1000
FIREFLY_HTTP_BIND=127.0.0.1
FIREFLY_HTTP_PORT=18080
FIREFLY_IMAGE_TAG=local
FIREFLY_PIP_INDEX_URL=https://pypi.org/simple
