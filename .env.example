DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# QQ 官方机器人（可选）。在 QQ 开放平台的「开发设置」中获取。
# QQ_BOT_ALLOWED_OPENIDS 为允许与 Firefly 私聊的 user_openid，多个用英文逗号隔开。
# 先留空启动一次，终端会打印你的 user_openid；填入后重启以启用访问控制。
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
QQ_BOT_ALLOWED_OPENIDS=
# 设为 true 后，启动 Firefly 桌面版时会同时启动 QQ Bot。
QQ_BOT_ENABLED=false

# 复用 NapCat 登录的个人 QQ（OneBot 正向 WebSocket，可选）。
# 令牌请从 NapCat 的 WebUI/配置中自行填入，不要复制到版本库。
NAPCAT_WS_URL=ws://127.0.0.1:8095
NAPCAT_TOKEN=
# 开启“QQ 对话”时，若 NapCat 未运行，Firefly 会自动启动此 QQ/NapCat 程序。
NAPCAT_QQ_EXECUTABLE=/home/pilgrim/Napcat/opt/QQ/qq
# 可选：已有登录缓存的机器人 QQ 可使用 -q <QQ号> 快速登录。
NAPCAT_QQ_ARGS=
# 设为 true 后，启动 Firefly 桌面版时会同时启动 NapCat QQ 桥接器。
NAPCAT_ENABLED=false
# 此处已按你的要求固定为唯一允许私聊 Firefly 的 QQ 号。
NAPCAT_ALLOWED_QQ=449140441
